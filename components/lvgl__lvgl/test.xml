<screen>
    <styles>
        <style name="style_main" bg_color="0x041d3a" text_color="0xfff" />
    </styles>

    <view style_text_color="0xfff">
        <style name="style_main" />
        <lv_label name="welcome_name" text="Secure Lock Box" style_text_font="montserrat_30" align="top_mid" y="10" />

        <lv_button name="unlock_button" align="center" width="420" y="-120" style_bg_color="0xe19419">
            <lv_label text="1:  Unlock Secure Box" style_text_color="0x000" style_text_font="montserrat_26" />
            <!-- Since the About screen is not permanent <screen_create_event>
			     shall be used to create it dynamically.  -->
            <screen_create_event screen="screen_biometric_select" anim_type="move_top" duration="500" />
        </lv_button>
        <lv_button name="change_pin_button" align="center" width="420" y="-50" style_bg_color="0x197de0">
            <lv_label text="2:  Change PIN" style_text_color="0x000" style_text_font="montserrat_26" />
            <!-- Since the About screen is not permanent <screen_create_event>
			     shall be used to create it dynamically.  -->
            <screen_create_event screen="screen_biometric_select" anim_type="move_top" duration="500" />
        </lv_button>
        <lv_button name="register_button" align="center" width="420" y="20" style_bg_color="0x21e019">
            <lv_label text="3:  Register Biometrics" style_text_color="0x000" style_text_font="montserrat_26" />
            <!-- Since the About screen is not permanent <screen_create_event>
			     shall be used to create it dynamically.  -->
            <screen_create_event screen="screen_biometric_select" anim_type="move_top" duration="500" />
        </lv_button>
        <lv_button name="admin_button" align="center" width="420" y="90" style_bg_color="0x8719e0">
            <lv_label text="4:  Admin" style_text_color="0x000" style_text_font="montserrat_26" />
            <!-- Since the About screen is not permanent <screen_create_event>
			     shall be used to create it dynamically.  -->
            <screen_create_event screen="screen_biometric_select" anim_type="move_top" duration="500" />
        </lv_button>
        <lv_button name="signout_button" align="center" width="420" y="160" style_bg_color="0xd9e019">
            <lv_label text="5:  Sign Out/Lock Secure Box" style_text_color="0x000" style_text_font="montserrat_26" />
            <!-- Since the About screen is not permanent <screen_create_event>
			     shall be used to create it dynamically.  -->
            <screen_create_event screen="screen_biometric_select" anim_type="move_top" duration="500" />
        </lv_button>
    </view>
</screen>
